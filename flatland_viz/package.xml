<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flatland_viz</name>
  <version>2.0.0</version>
  <description>The flatland_viz package (ROS 2, rviz2-based)</description>
  <license>BSD-3-Clause</license>
  <url type="website">https://github.com/Worthle</url>

  <maintainer email="leventfaruksoysal6@gmail.com">Worthle</maintainer>
  <author email="joseph@avidbots.com">Joseph Duchesne</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>rviz_default_plugins</depend>
  <depend>rviz_ogre_vendor</depend>
  <depend>flatland_server</depend>
  <depend>flatland_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>libqt5-core</depend>
  <depend>libqt5-gui</depend>
  <depend>libqt5-widgets</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
